[Unit]
Description=WHY AI Strategy Discovery (isolated paper only)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=whydiscovery
Group=whydiscovery
WorkingDirectory=/opt/why-discovery
Environment=# omitted: configure a separate Vera environment
Environment=# omitted: configure a separate Vera environment
Environment=# omitted: configure a separate Vera environment
EnvironmentFile=/etc/why-discovery/paper.env
EnvironmentFile=/etc/why-discovery/model.env
ExecStart=/opt/migration-python314/bin/python -m discovery.server
Restart=on-failure
RestartSec=5
UMask=0077
StateDirectory=why-discovery
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/why-discovery
InaccessiblePaths=-/opt/why-yellow/secrets -/etc/why-shadow-lab

[Install]
WantedBy=multi-user.target
