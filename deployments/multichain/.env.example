# VELLA configuration; legacy ADP_ names remain supported. Do not source Vela's environment.
# Keep these existing variable names compatible with the renamed application.
# Intended production origin after validation and authorization: https://defivela.xyz
VERA_PROTOCOL_ORIGIN=http://127.0.0.1:8802
VERA_PROTOCOL_EXECUTION=PAPER
VERA_PROTOCOL_LENDING=DEMO
# Enable outbound chain/model/market reads only in an authorized network environment.
VERA_PROTOCOL_NETWORK_ENABLED=0
VERA_PROTOCOL_RPC=https://rpc.testnet.dogeos.com/
# Populate only after explicit authorization and a new project's testnet deployment.
VERA_PROTOCOL_FACTORY=
# App-specific public SDK client ID, with registered application origin.
VERA_PROTOCOL_MYDOGE_CLIENT_ID=
# Optional, public, application-specific ID for external WalletConnect sessions.
# Native MyDoge does not require WalletConnect. No fallback project ID is used.
VERA_PROTOCOL_WALLETCONNECT_PROJECT_ID=
# Dedicated DEMO ledger attestor; never a user seed/key or Vela credential.
VERA_PROTOCOL_DEMO_ATTESTOR_KEY=
# Dedicated Vela AI configuration; never put these values in frontend files.
# VERA_PROTOCOL_MODEL* and ADP_MODEL* remain compatible; conflicts fail closed.
VELA_MODEL_ENDPOINT=https://api.openai.com/v1/responses
VELA_MODEL=
VELA_MODEL_KEY=
