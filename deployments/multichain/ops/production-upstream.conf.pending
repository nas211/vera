# INACTIVE. Do not include before live acceptance, verified backup/rollback and approval.
# Replaces the old app's location blocks inside the EXISTING defivela.xyz TLS server.
# Keep its server_name, certificate, HTTP redirect and other domains unchanged.
# Backend is the independently staged VELLA loopback TLS listener.
location / {
    proxy_pass https://127.0.0.1:8802;
    proxy_http_version 1.1;
    proxy_ssl_server_name on;
    proxy_ssl_name defivela.xyz;
    proxy_ssl_verify on;
    proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
    proxy_set_header Host defivela.xyz;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header Connection "";
}
location /ws/ {
    proxy_pass https://127.0.0.1:8802;
    proxy_http_version 1.1;
    proxy_ssl_server_name on;
    proxy_ssl_name defivela.xyz;
    proxy_ssl_verify on;
    proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
    proxy_set_header Host defivela.xyz;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_read_timeout 120s;
    proxy_buffering off;
}
