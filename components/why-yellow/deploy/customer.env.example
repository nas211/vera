# /opt/why-yellow/secrets/customer.env  (chmod 0600, root only, NEVER committed)
# Public values (the browser receives exactly these two via /yellow/api/public-config):
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon public key>
# Server-only: direct Postgres connection (Supabase → Project Settings → Database, session mode).
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<db-password>@<host>:5432/postgres?sslmode=require
# Server-only, ONLY for legacy projects that still sign JWTs with HS256. Projects on
# asymmetric signing keys need nothing here (the public JWKS is fetched from SUPABASE_URL).
#SUPABASE_JWT_SECRET=<jwt secret>
#
# DO NOT put SUPABASE_SERVICE_ROLE_KEY here: the platform refuses to start if it is set.
# DO NOT put YELLOW_ARMED here: arming is a separate, explicit owner action.
#
# Server-only Stripe Billing. Create one recurring Price for each paid plan/interval.
#STRIPE_SECRET_KEY=sk_live_...
#STRIPE_WEBHOOK_SECRET=whsec_...
#STRIPE_PRICE_CORE_MONTHLY=price_...
#STRIPE_PRICE_CORE_ANNUAL=price_...
#STRIPE_PRICE_PRO_MONTHLY=price_...
#STRIPE_PRICE_PRO_ANNUAL=price_...
#STRIPE_PRICE_PRIME_MONTHLY=price_...
#STRIPE_PRICE_PRIME_ANNUAL=price_...
#WHY_SITE_URL=https://whytradingbot.com
#
# WEEX remains INTEGRATING unless explicitly enabled after production certification.
# Broker attribution is server-only and is added to every WHY-generated WEEX order.
#WEEX_BROKER_ID=<WEEX-issued broker id>
#WEEX_BROKER_API_KEY=<optional broker reporting key>
#WEEX_BROKER_API_SECRET=<optional broker reporting secret>
#WEEX_BROKER_API_PASSPHRASE=<optional broker reporting passphrase>
#WEEX_BASE_URL=https://api-contract.weex.com
#WEEX_LIVE_ENABLED=0
#
# Optional tuning:
#WY_CUSTOMER_API_PORT=8104
#WY_CUSTOMER_RUNNER=1
#WY_CUSTOMER_FEED=1
#WY_VERIFY_RATE_PER_MIN=5
