    # --- WHY x Yellow CUSTOMER app + API (why-yellow-customer.service, loopback :8104) ----
    # Longest-prefix ^~ locations win over the existing "^~ /yellow/" (paper book, :8102).
    # /yellow/api/book stays on the paper book (its page fetches it).
    location = /yellow/api/book {
        proxy_pass http://127.0.0.1:8102/yellow/api/book;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        add_header Cache-Control "no-store";
    }
    location ^~ /yellow/api/ {
        proxy_pass http://127.0.0.1:8104/yellow/api/;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
        client_max_body_size 8k;
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options "nosniff" always;
    }
    location = /yellow/app { return 301 /yellow/app/; }
    location ^~ /yellow/app/ {
        alias /opt/why-yellow/webapp/;
        index index.html;
        add_header X-Robots-Tag "noindex, nofollow" always;
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header X-Frame-Options "DENY" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' https://cdn.jsdelivr.net; connect-src 'self' https://*.supabase.co wss://*.supabase.co; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
    }
