    # Partners portal — invite-only, read-only paper-book dashboard
    # (why-partners.service, loopback :8099). Auth, no-store headers and CSP
    # are set by the backend; nginx only proxies. ^~ so nothing under
    # /partners can ever fall through to the static root.
    location ^~ /partners {
        proxy_pass http://127.0.0.1:8099;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
        client_max_body_size 8k;
    }
