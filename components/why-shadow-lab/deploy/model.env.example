# Configure the owner-authorized dedicated OpenAI key, not trading credentials.
# Install privately as /etc/why-shadow-lab/model.env, owner root, mode 0600.
# The agents service receives these through systemd; it cannot read /etc secrets.
WHY_LAB_LLM_ENDPOINT=https://api.openai.com/v1/responses
WHY_LAB_LLM_MODEL=gpt-6-luna
WHY_LAB_LLM_KEY=
