[Unit]
Description=WHY x Yellow strategy -> Bybit DEMO Trading bridge (signals from the Yellow mark-candle shadow; orders ONLY to api-demo.bybit.com; guard fails closed) on loopback :8107
After=network-online.target why-yellow-markshadow.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/why-bybit-demo-yellow
Environment=# omitted: configure a separate Vera environment
Environment=# omitted: configure a separate Vera environment
ExecStart=/usr/bin/python3 /opt/why-bybit-demo-yellow/engine.py
Restart=always
RestartSec=10
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/opt/why-bybit-demo-yellow/state /opt/why-bybit-demo-yellow/logs
ReadOnlyPaths=/opt/why-yellow-markshadow /opt/why-yellow/yellow_paper.py

[Install]
WantedBy=multi-user.target
