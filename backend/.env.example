# Optional values. Inject these into Vela processes, never commit actual secrets.
VELA_OPERATOR_PRIVATE_KEY=
VELA_MAX_LEVERAGE=3
VELA_SIZE_FRACTION=0.10
VELA_SLIPPAGE=0.0002
VELA_LOSS_BUDGET=2
VELA_CONFIRMATIONS=3
# Safe default: feeds and event indexing run, but no transactions or new entries.
VELA_CHAIN_WRITES=false
VELA_MAX_TX_FEE_DOGE=0.25
VELA_DAILY_FEE_BUDGET_DOGE=0.5
VELA_GAS_RESERVE_DOGE=1
# Hermes requires an API key since August 26, 2026.
VELA_PYTH_API_KEY=
# Discovery AI is unavailable without separate Vela model credentials.
VELA_MODEL=
VELA_MODEL_KEY=
VELA_MODEL_ENDPOINT=https://api.openai.com/v1/responses

# Internal engineering harness only; public visitors use wallet-funded sessions.
VELA_ENABLE_PRACTICE=false
